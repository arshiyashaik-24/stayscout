{
  "name": "stayscout",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev:api": "npm run dev -w @stayscout/api",
    "dev:web": "npm run dev -w @stayscout/web",
    "typecheck": "tsc -p packages/ranking && tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run",
    "build": "npm run build -w @stayscout/web"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
